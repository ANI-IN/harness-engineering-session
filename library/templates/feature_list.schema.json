{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ANI-IN/harness-engineering-session/library/templates/feature_list.schema.json",
  "title": "feature_list.json",
  "description": "Machine-readable scope and state for agent work. One entry per feature; passing requires evidence. Motivated by the course's feature-list and evidence-based-completion lessons.",
  "type": "object",
  "required": ["project", "updated", "features"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project name."
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of last update, ISO 8601 (YYYY-MM-DD)."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["id", "title", "behavior", "verification", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Stable kebab-case identifier."
        },
        "title": { "type": "string", "minLength": 1 },
        "behavior": {
          "type": "string",
          "minLength": 1,
          "description": "The single user-visible behavior this feature delivers."
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "description": "The executable command whose exit 0 proves the behavior."
        },
        "status": {
          "enum": ["not-started", "in-progress", "blocked", "passing"],
          "description": "State machine: not-started -> in-progress -> passing; blocked is reachable from in-progress."
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passing" } } },
          "then": { "required": ["evidence"] }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["command", "observed", "date"],
      "additionalProperties": false,
      "description": "Proof of completion: what was run, what was observed, when. Prose about the code is not evidence.",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "observed": {
          "type": "string",
          "minLength": 1,
          "description": "The observable result, e.g. 'exit 0, 12 tests passed'."
        },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
