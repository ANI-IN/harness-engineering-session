{
  "entry": {
    "python": "python/main.py",
    "typescript": "typescript/main.ts"
  },
  "cases": [
    {
      "name": "partly-reverted-under-a-later-change",
      "args": [
        "fixtures/workspaces/workspace-touched",
        "fixtures/journals/journal-touched.json"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 1,
        "stdout": "expected/partly-reverted.json",
        "kind": "json"
      }
    },
    {
      "name": "mixed-journal",
      "args": [
        "fixtures/workspaces/workspace-applied",
        "fixtures/journals/journal-mixed.json"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/mixed.json",
        "kind": "json"
      }
    },
    {
      "name": "two-appends-to-one-file",
      "args": [
        "fixtures/workspaces/workspace-applied",
        "fixtures/journals/journal-two-appends.json"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/two-appends.json",
        "kind": "json"
      }
    },
    {
      "name": "missing-workspace",
      "args": [
        "fixtures/workspaces/no-such-workspace",
        "fixtures/journals/journal-mixed.json"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 2,
        "stdout": null,
        "kind": "text"
      }
    }
  ]
}
