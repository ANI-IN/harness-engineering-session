{
  "entry": {
    "python": "python/main.py",
    "typescript": "typescript/main.ts"
  },
  "cases": [
    {
      "name": "ready",
      "args": ["fixtures/repos/repo-ready"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/ready.json", "kind": "json" }
