{
  "task": "add csv export to the desktop report tool",
  "layers": ["unit", "e2e"],
  "components": [
    {
      "id": "selection-ui",
      "tier": "ui",
      "ops": [
        {"op": "set", "field": "report", "value": "quarterly"}
      ],
      "unit_case": {
        "input": {},
        "expects": {"report": "quarterly"}
      }
    },
    {
      "id": "path-builder",
      "tier": "service",
      "ops": [
        {"op": "format", "field": "path", "template": "/srv/reports/exports/{report}.csv"}
      ],
      "unit_case": {
        "input": {"report": "quarterly"},
        "expects": {
          "report": "quarterly",
          "path": "/srv/reports/exports/quarterly.csv"
        }
      }
    },
    {
      "id": "file-writer",
      "tier": "io",
      "ops": [
        {"op": "require-prefix", "field": "path", "prefix": "/"},
        {"op": "copy", "from": "path", "to": "written"}
      ],
      "unit_case": {
        "input": {
          "report": "quarterly",
          "path": "/srv/reports/exports/quarterly.csv"
        },
        "expects": {
          "report": "quarterly",
          "path": "/srv/reports/exports/quarterly.csv",
          "written": "/srv/reports/exports/quarterly.csv"
        }
      }
    }
  ],
  "pipelines": [
    {
      "id": "assembled-export-flow",
      "stages": ["selection-ui", "path-builder", "file-writer"],
      "start": {},
      "expects": {"field": "written", "value": "/srv/reports/exports/quarterly.csv"}
    }
  ]
}
