diff --git a/tests/visible/test_c5_own_role.py b/tests/visible/test_c5_own_role.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c5_own_role.py
@@ -0,0 +1,43 @@
+"""C5: an admin cannot change their own role."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def audit_rows(client, admin: int) -> int:  # type: ignore[no-untyped-def]
+    return len(client.get("/audit?limit=100", headers=auth(admin)).json()["items"])
+
+
+def test_own_role_change_is_rejected_without_an_audit_row(client, acme) -> None:
+    before = audit_rows(client, acme.admin)
+    response = client.patch(
+        f"/users/{acme.admin}", json={"role": "member"}, headers=auth(acme.admin)
+    )
+    assert response.status_code == 422
+    assert error_code(response) == "cannot_change_own_role"
+    assert audit_rows(client, acme.admin) == before
+    assert client.get(f"/users/{acme.admin}", headers=auth(acme.admin)).json()["role"] == "admin"
+
+
+def test_same_role_and_own_name_still_work(client, acme) -> None:
+    body = {"name": "Acme Boss", "role": "admin"}
+    response = client.patch(f"/users/{acme.admin}", json=body, headers=auth(acme.admin))
+    assert response.status_code == 200
+    assert response.json()["name"] == "Acme Boss"
+
+
+def test_admin_still_changes_other_users_roles(client, acme) -> None:
+    response = client.patch(
+        f"/users/{acme.member}", json={"role": "viewer"}, headers=auth(acme.admin)
+    )
+    assert response.status_code == 200
+    assert response.json()["role"] == "viewer"
+
+
+def test_another_orgs_user_is_not_found(client, acme, globex) -> None:
+    response = client.patch(
+        f"/users/{globex.admin}", json={"role": "member"}, headers=auth(acme.admin)
+    )
+    assert response.status_code == 404
+    assert error_code(response) == "not_found"
