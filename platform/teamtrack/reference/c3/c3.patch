diff --git a/tests/visible/test_c3_priority_filter.py b/tests/visible/test_c3_priority_filter.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c3_priority_filter.py
@@ -0,0 +1,42 @@
+"""C3: a project's issue list filters by priority."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def test_priority_filter_lists_only_that_priority(client, acme) -> None:
+    url = f"/projects/{acme.projects[0]}/issues?priority=medium"
+    body = client.get(url, headers=auth(acme.viewer)).json()
+    assert [i["id"] for i in body["items"]] == [2, 5, 8]
+    assert body["next_cursor"] is None
+
+
+def test_unknown_priority_is_rejected(client, acme) -> None:
+    url = f"/projects/{acme.projects[0]}/issues?priority=urgent"
+    response = client.get(url, headers=auth(acme.admin))
+    assert response.status_code == 422
+    assert error_code(response) == "validation_error"
+
+
+def test_another_orgs_project_is_not_found(client, acme, globex) -> None:
+    url = f"/projects/{globex.projects[0]}/issues?priority=low"
+    response = client.get(url, headers=auth(acme.admin))
+    assert response.status_code == 404
+    assert error_code(response) == "not_found"
+
+
+def test_priority_filter_pages_without_gaps_or_repeats(client, acme) -> None:
+    url = f"/projects/{acme.projects[0]}/issues?priority=low&limit=3"
+    page1 = client.get(url, headers=auth(acme.member)).json()
+    assert [i["id"] for i in page1["items"]] == [1, 4, 7]
+    page2 = client.get(f"{url}&cursor={page1['next_cursor']}", headers=auth(acme.member)).json()
+    assert [i["id"] for i in page2["items"]] == [10]
+    assert page2["next_cursor"] is None
+
+
+def test_priority_filter_rejects_a_bad_cursor(client, acme) -> None:
+    url = f"/projects/{acme.projects[0]}/issues?priority=low&cursor=not-a-cursor"
+    response = client.get(url, headers=auth(acme.admin))
+    assert response.status_code == 400
+    assert error_code(response) == "invalid_cursor"
