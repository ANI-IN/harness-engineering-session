diff --git a/tests/visible/test_c4_trim_titles.py b/tests/visible/test_c4_trim_titles.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c4_trim_titles.py
@@ -0,0 +1,49 @@
+"""C4: issue titles are stored without surrounding whitespace."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def test_member_create_trims_the_title(client, acme) -> None:
+    response = client.post(
+        f"/projects/{acme.projects[0]}/issues",
+        json={"title": "  Cache misses  "},
+        headers=auth(acme.member),
+    )
+    assert response.status_code == 201
+    assert response.json()["title"] == "Cache misses"
+
+
+def test_member_patch_trims_the_title(client, acme) -> None:
+    response = client.patch(
+        f"/issues/{acme.issues[0]}", json={"title": "\tNew title  "}, headers=auth(acme.member)
+    )
+    assert response.status_code == 200
+    assert response.json()["title"] == "New title"
+
+
+def test_limit_counts_the_trimmed_title(client, acme) -> None:
+    response = client.post(
+        f"/projects/{acme.projects[0]}/issues",
+        json={"title": " " + "y" * 200 + " "},
+        headers=auth(acme.admin),
+    )
+    assert response.status_code == 201
+    assert response.json()["title"] == "y" * 200
+
+
+def test_blank_title_is_still_rejected(client, acme) -> None:
+    response = client.post(
+        f"/projects/{acme.projects[0]}/issues", json={"title": "   "}, headers=auth(acme.member)
+    )
+    assert response.status_code == 422
+    assert error_code(response) == "validation_error"
+
+
+def test_viewer_still_cannot_create(client, acme) -> None:
+    response = client.post(
+        f"/projects/{acme.projects[0]}/issues", json={"title": " Nope "}, headers=auth(acme.viewer)
+    )
+    assert response.status_code == 403
+    assert error_code(response) == "forbidden"
