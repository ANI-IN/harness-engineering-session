diff --git a/tests/visible/test_c8_board_assignee.py b/tests/visible/test_c8_board_assignee.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c8_board_assignee.py
@@ -0,0 +1,27 @@
+"""C8: the board's issue detail page shows the assignee."""
+
+from __future__ import annotations
+
+
+def login(client, email: str) -> None:  # type: ignore[no-untyped-def]
+    response = client.post("/board/login", data={"email": email}, follow_redirects=False)
+    assert response.status_code == 303
+
+
+def test_detail_page_names_the_assignee(client, globex) -> None:
+    login(client, "member@globex.test")
+    html = client.get(f"/board/issues/{globex.issues[0]}").text
+    assert f'<dd class="assignee" data-user-id="{globex.member}">Globex Member</dd>' in html
+
+
+def test_detail_page_says_unassigned(client, acme) -> None:
+    login(client, "admin@acme.test")
+    html = client.get(f"/board/issues/{acme.issues[1]}").text
+    assert '<dd class="assignee">Unassigned</dd>' in html
+
+
+def test_bad_session_cookie_goes_to_login(client, acme) -> None:
+    client.cookies.set("tt_session", "tt-abc")
+    response = client.get(f"/board/issues/{acme.issues[0]}", follow_redirects=False)
+    assert response.status_code == 303
+    assert response.headers["location"] == "/board/login"
