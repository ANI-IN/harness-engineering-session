diff --git a/tests/visible/test_c6_audit_action_filter.py b/tests/visible/test_c6_audit_action_filter.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c6_audit_action_filter.py
@@ -0,0 +1,54 @@
+"""C6: the audit log filters by action."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def make_issues(client, acme, count: int) -> list[int]:  # type: ignore[no-untyped-def]
+    ids = []
+    for n in range(count):
+        response = client.post(
+            f"/projects/{acme.projects[0]}/issues",
+            json={"title": f"Audit {n}"},
+            headers=auth(acme.member),
+        )
+        assert response.status_code == 201
+        ids.append(int(response.json()["id"]))
+    return ids
+
+
+def test_action_filter_lists_only_that_action(client, acme) -> None:
+    client.post("/projects", json={"name": "Ops", "key": "OPS"}, headers=auth(acme.admin))
+    created = make_issues(client, acme, 1)
+    body = client.get("/audit?action=issue.create", headers=auth(acme.admin)).json()
+    assert [(r["action"], r["entity_id"]) for r in body["items"]] == [("issue.create", created[0])]
+    assert body["next_cursor"] is None
+
+
+def test_action_filter_pages_without_gaps_or_repeats(client, acme) -> None:
+    created = make_issues(client, acme, 4)
+    page1 = client.get("/audit?action=issue.create&limit=3", headers=auth(acme.admin)).json()
+    assert [r["entity_id"] for r in page1["items"]] == created[:3]
+    url = f"/audit?action=issue.create&limit=3&cursor={page1['next_cursor']}"
+    page2 = client.get(url, headers=auth(acme.admin)).json()
+    assert [r["entity_id"] for r in page2["items"]] == created[3:]
+    assert page2["next_cursor"] is None
+
+
+def test_action_length_is_checked(client, acme) -> None:
+    for action in ("", "a" * 51):
+        response = client.get("/audit", params={"action": action}, headers=auth(acme.admin))
+        assert response.status_code == 422
+        assert error_code(response) == "validation_error"
+
+
+def test_action_filter_rejects_a_bad_cursor(client, acme) -> None:
+    response = client.get("/audit?action=issue.create&cursor=bad", headers=auth(acme.admin))
+    assert response.status_code == 400
+    assert error_code(response) == "invalid_cursor"
+
+
+def test_action_filter_is_still_admin_only(client, acme) -> None:
+    response = client.get("/audit?action=issue.create", headers=auth(acme.member))
+    assert response.status_code == 403
