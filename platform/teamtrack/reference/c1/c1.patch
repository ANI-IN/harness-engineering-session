diff --git a/tests/visible/test_c1_users_role_filter.py b/tests/visible/test_c1_users_role_filter.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c1_users_role_filter.py
@@ -0,0 +1,46 @@
+"""C1: the user list filters by role."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def add_member(client, admin: int, email: str) -> int:  # type: ignore[no-untyped-def]
+    body = {"email": email, "name": "Extra Member", "role": "member"}
+    response = client.post("/users", json=body, headers=auth(admin))
+    assert response.status_code == 201
+    return int(response.json()["id"])
+
+
+def test_role_filter_lists_only_that_role(client, acme) -> None:
+    body = client.get("/users?role=viewer", headers=auth(acme.member)).json()
+    assert [user["id"] for user in body["items"]] == [acme.viewer]
+    assert body["next_cursor"] is None
+
+
+def test_role_filter_stays_in_the_callers_org(client, globex) -> None:
+    body = client.get("/users?role=admin", headers=auth(globex.viewer)).json()
+    assert [user["id"] for user in body["items"]] == [globex.admin]
+
+
+def test_unknown_role_is_rejected(client, acme) -> None:
+    response = client.get("/users?role=owner", headers=auth(acme.admin))
+    assert response.status_code == 422
+    assert error_code(response) == "validation_error"
+
+
+def test_role_filter_pages_without_gaps_or_repeats(client, acme) -> None:
+    extra = [add_member(client, acme.admin, f"extra{n}@acme.test") for n in range(3)]
+    expected = [acme.member, *extra]
+    page1 = client.get("/users?role=member&limit=3", headers=auth(acme.admin)).json()
+    assert [user["id"] for user in page1["items"]] == expected[:3]
+    cursor = page1["next_cursor"]
+    page2 = client.get(f"/users?role=member&limit=3&cursor={cursor}", headers=auth(acme.admin))
+    assert [user["id"] for user in page2.json()["items"]] == expected[3:]
+    assert page2.json()["next_cursor"] is None
+
+
+def test_role_filter_rejects_a_bad_cursor(client, acme) -> None:
+    response = client.get("/users?role=member&cursor=not-a-cursor", headers=auth(acme.admin))
+    assert response.status_code == 400
+    assert error_code(response) == "invalid_cursor"
