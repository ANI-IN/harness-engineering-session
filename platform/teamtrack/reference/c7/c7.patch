diff --git a/tests/visible/test_c7_member_details.py b/tests/visible/test_c7_member_details.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c7_member_details.py
@@ -0,0 +1,30 @@
+"""C7: project members carry the user's email, name, and role."""
+
+from __future__ import annotations
+
+from conftest import auth
+
+
+def test_member_list_shows_user_details(client, acme) -> None:
+    body = client.get(f"/projects/{acme.projects[0]}/members", headers=auth(acme.viewer)).json()
+    assert [(m["user_id"], m["role"]) for m in body["items"]] == [
+        (acme.admin, "admin"),
+        (acme.member, "member"),
+    ]
+    assert body["items"][0]["email"] == "admin@acme.test"
+    assert body["items"][1]["name"] == "Acme Member"
+
+
+def test_added_member_shows_user_details(client, acme) -> None:
+    response = client.post(
+        f"/projects/{acme.projects[1]}/members",
+        json={"user_id": acme.viewer},
+        headers=auth(acme.admin),
+    )
+    assert response.status_code == 201
+    body = response.json()
+    assert (body["user_id"], body["email"], body["role"]) == (
+        acme.viewer,
+        "viewer@acme.test",
+        "viewer",
+    )
