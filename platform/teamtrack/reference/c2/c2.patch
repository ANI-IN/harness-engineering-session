diff --git a/tests/visible/test_c2_project_search.py b/tests/visible/test_c2_project_search.py
new file mode 100644
--- /dev/null
+++ b/tests/visible/test_c2_project_search.py
@@ -0,0 +1,51 @@
+"""C2: the project list searches by name."""
+
+from __future__ import annotations
+
+from conftest import auth, error_code
+
+
+def add_project(client, admin: int, name: str, key: str) -> int:  # type: ignore[no-untyped-def]
+    response = client.post("/projects", json={"name": name, "key": key}, headers=auth(admin))
+    assert response.status_code == 201
+    return int(response.json()["id"])
+
+
+def test_search_is_a_case_insensitive_substring(client, acme) -> None:
+    body = client.get("/projects?q=SITE", headers=auth(acme.viewer)).json()
+    assert [p["id"] for p in body["items"]] == [acme.projects[0]]
+    assert body["next_cursor"] is None
+
+
+def test_search_stays_in_the_callers_org(client, globex) -> None:
+    body = client.get("/projects?q=web", headers=auth(globex.admin)).json()
+    assert body == {"items": [], "next_cursor": None}
+
+
+def test_search_treats_percent_as_a_plain_character(client, acme) -> None:
+    body = client.get("/projects", params={"q": "%"}, headers=auth(acme.admin)).json()
+    assert body["items"] == []
+
+
+def test_search_length_is_checked(client, acme) -> None:
+    for q in ("", "x" * 101):
+        response = client.get("/projects", params={"q": q}, headers=auth(acme.admin))
+        assert response.status_code == 422
+        assert error_code(response) == "validation_error"
+
+
+def test_search_pages_without_gaps_or_repeats(client, acme) -> None:
+    extra = [add_project(client, acme.admin, f"Web {n}", f"WEB{chr(65 + n)}") for n in range(3)]
+    expected = [acme.projects[0], *extra]
+    page1 = client.get("/projects?q=web&limit=3", headers=auth(acme.admin)).json()
+    assert [p["id"] for p in page1["items"]] == expected[:3]
+    cursor = page1["next_cursor"]
+    page2 = client.get(f"/projects?q=web&limit=3&cursor={cursor}", headers=auth(acme.admin))
+    assert [p["id"] for p in page2.json()["items"]] == expected[3:]
+    assert page2.json()["next_cursor"] is None
+
+
+def test_search_rejects_a_bad_cursor(client, acme) -> None:
+    response = client.get("/projects?q=web&cursor=not-a-cursor", headers=auth(acme.admin))
+    assert response.status_code == 400
+    assert error_code(response) == "invalid_cursor"
