# shipharness configuration. Copy to .env at the repo root and fill in the two required keys:
#   cp .env.example .env
# .env is git-ignored. Never commit it, paste it into an issue, or share a screenshot of it.
# Keys are never printed, logged, traced, or passed into any container.

# --- Required -----------------------------------------------------------------
# OpenAI API key from a paid account (Build tier or higher, at least $5 of credit).
OPENAI_API_KEY=
# LangSmith API key from a free Developer account (no card on file).
LANGSMITH_API_KEY=

# --- Models ---------------------------------------------------------------------
OPENAI_MODEL=gpt-6-luna
# Provisional; the M6 pilot sets the final value.
OPENAI_REASONING_EFFORT=medium
OPENAI_EVAL_MODEL=gpt-5.6-luna
OPENAI_EVAL_REASONING_EFFORT=medium
# auto | default | flex | fast. Keep auto here: the class make targets (demo-N, show-N, final) pass
# --profile class, which uses fast for the agent arms (calls are charged by the tier the response
# reports). flex only for experiment batches, and only if M6 confirms tool calling on Flex.
OPENAI_SERVICE_TIER=auto

# --- LangSmith ------------------------------------------------------------------
LANGSMITH_TRACING=true
# EU accounts: https://eu.api.smith.langchain.com (no trailing slash)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# The class day (YYYY-MM-DD), set explicitly before class: class commands (make demo-N, final,
# swap-N) refuse without it. It names the class LangSmith project shipharness-class-<date> and keys
# the class session cost cap. Pilot runs use PURPOSE=pilot (project shipharness-pilot) instead.
SHIPHARNESS_CLASS_DATE=

# --- Cost caps (USD) ------------------------------------------------------------
MAX_RUN_COST_USD=0.20
MAX_FINAL_RUN_COST_USD=0.25
MAX_REVIEW_COST_USD=0.04
MAX_SESSION_COST_USD=2.50
MAX_BATCH_COST_USD=2.50
MAX_EXPERIMENT_TOTAL_USD=25.00
MAX_BUILD_TOTAL_USD=15.00

# --- Run limits -----------------------------------------------------------------
MAX_TURNS_PER_SESSION=30
MAX_OUTPUT_TOKENS=8000
WRAPUP_TURNS=3
TOOL_TIMEOUT_S=120
RUN_TIMEOUT_S=300
HARNESS_TIMEOUT_S=120
MAX_CONCURRENCY=4

# --- Sandbox --------------------------------------------------------------------
# docker | none   (none = UNSANDBOXED fallback; results are not official)
SANDBOX_MODE=docker
# docker | podman
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE_AGENT=shipharness-agent:1
SANDBOX_IMAGE_REFEREE=shipharness-referee:1
# CPUs per arm, referee, and preview container; the class profile sets 2 for every container.
SANDBOX_CPUS=1.0

# --- Paths ----------------------------------------------------------------------
RUNS_DIR=.shipharness/runs
EXPORTS_DIR=exports
# Model prices (USD per 1M tokens); a configured model missing from this file is a startup error.
# PRICES_FILE=platform/config/prices.toml
