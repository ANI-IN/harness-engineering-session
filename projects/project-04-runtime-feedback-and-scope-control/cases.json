{
  "entry": {
    "python": "python/main.py",
    "typescript": "typescript/main.ts"
  },
  "cases": [
    {
      "name": "init-records-metadata-and-logs",
      "args": ["init", "--data-dir", "kb-data", "--seed", "fixtures/kb-data/documents"],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/init.json",
        "kind": "json",
        "files": [
          {
            "path": "kb-data/index/documents-meta.json",
            "expected": "fixtures/kb-data/index/documents-meta.json",
            "kind": "json"
          },
          {
            "path": "kb-data/log/events.jsonl",
            "expected": "expected/log-after-init.jsonl",
            "kind": "text"
          }
        ]
      }
    },
    {
      "name": "list-from-metadata",
      "args": ["list", "--data-dir", "fixtures/kb-data"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/list.json", "kind": "json" }
    },
    {
      "name": "list-before-init",
      "args": ["list", "--data-dir", "missing-dir"],
      "stdin": null,
      "expect": { "exit_code": 1, "stdout": null, "kind": "text" }
    },
    {
      "name": "import-extracts-metadata",
      "args": ["import", "--data-dir", "fixtures/kb-data", "fixtures/imports/field-guide.md"],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/import.json",
        "kind": "json",
        "files": [
          {
            "path": "fixtures/kb-data/documents/field-guide.md",
            "expected": "fixtures/imports/field-guide.md",
            "kind": "text"
          }
        ]
      }
    },
    {
      "name": "show-detail-with-metadata",
      "args": ["show", "--data-dir", "fixtures/kb-data", "retrieval-plan"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/show.json", "kind": "json" }
    },
    {
      "name": "show-unknown-id",
      "args": ["show", "--data-dir", "fixtures/kb-data", "no-such-document"],
      "stdin": null,
      "expect": { "exit_code": 1, "stdout": null, "kind": "text" }
    },
    {
      "name": "index-builds-chunks",
      "args": ["index", "--data-dir", "fixtures/kb-data"],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/index.json",
        "kind": "json",
        "files": [
          {
            "path": "fixtures/kb-data/index/chunks.json",
            "expected": "fixtures/kb-data-indexed/index/chunks.json",
            "kind": "json"
          }
        ]
      }
    },
    {
      "name": "index-idempotent",
      "args": ["index", "--data-dir", "fixtures/kb-data-indexed"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/index-idempotent.json", "kind": "json" }
    },
    {
      "name": "status-ready",
      "args": ["status", "--data-dir", "fixtures/kb-data-indexed"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/status-ready.json", "kind": "json" }
    },
    {
      "name": "status-corrupt",
      "args": ["status", "--data-dir", "fixtures/kb-data-corrupt"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/status-corrupt.json", "kind": "json" }
    },
    {
      "name": "ask-grounded-in-chunks",
      "args": ["ask", "--data-dir", "fixtures/kb-data-indexed", "Which lines become citations in the ranking?"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/ask-ranking.json", "kind": "json" }
    },
    {
      "name": "ask-corrupt-refuses",
      "args": ["ask", "--data-dir", "fixtures/kb-data-corrupt", "Which lines become citations in the ranking?"],
      "stdin": null,
      "expect": { "exit_code": 1, "stdout": null, "kind": "text" }
    },
    {
      "name": "rebuild-recovers-the-corrupt-index",
      "args": ["index", "--data-dir", "fixtures/kb-data-corrupt", "--rebuild"],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/rebuild.json",
        "kind": "json",
        "files": [
          {
            "path": "fixtures/kb-data-corrupt/index/chunks.json",
            "expected": "fixtures/kb-data-indexed/index/chunks.json",
            "kind": "json"
          }
        ]
      }
    },
    {
      "name": "logs-surface-the-warning",
      "args": ["logs", "--data-dir", "fixtures/kb-data-corrupt", "--level", "WARN"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/logs-warn.json", "kind": "json" }
    },
    {
      "name": "guard-sound",
      "args": ["guard", "--data-dir", "fixtures/kb-data-indexed"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/guard.json", "kind": "json" }
    },
    {
      "name": "serve-self-check",
      "args": ["serve", "--data-dir", "fixtures/kb-data-indexed", "--self-check"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/self-check.json", "kind": "json" }
    },
    {
      "name": "workspace-ready",
      "args": ["workspace-check", "--workspace", "fixtures/workspaces/workspace-ready"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/workspace-ready.json", "kind": "json" }
    },
    {
      "name": "workspace-stale",
      "args": ["workspace-check", "--workspace", "fixtures/workspaces/workspace-stale"],
      "stdin": null,
      "expect": { "exit_code": 1, "stdout": "expected/workspace-stale.json", "kind": "json" }
    },
    {
      "name": "two-session-continuity",
      "args": ["continuity", "--workdir", "work"],
      "stdin": null,
      "expect": { "exit_code": 0, "stdout": "expected/continuity.json", "kind": "json" }
    },
    {
      "name": "usage-error",
      "args": ["frobnicate"],
      "stdin": null,
      "expect": { "exit_code": 2, "stdout": null, "kind": "text" }
    }
  ]
}
