{
  "entry": {
    "python": "python/main.py",
    "typescript": "typescript/main.ts"
  },
  "cases": [
    {
      "name": "init-records-metadata",
      "args": [
        "init",
        "--data-dir",
        "kb-data",
        "--seed",
        "fixtures/kb-data/documents"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/init.json",
        "kind": "json",
        "files": [
          {
            "path": "kb-data/index/documents-meta.json",
            "expected": "fixtures/kb-data/index/documents-meta.json",
            "kind": "json"
          }
        ]
      }
    },
    {
      "name": "list-from-metadata",
      "args": [
        "list",
        "--data-dir",
        "fixtures/kb-data"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/list.json",
        "kind": "json"
      }
    },
    {
      "name": "list-before-init",
      "args": [
        "list",
        "--data-dir",
        "missing-dir"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 1,
        "stdout": null,
        "kind": "text"
      }
    },
    {
      "name": "import-extracts-metadata",
      "args": [
