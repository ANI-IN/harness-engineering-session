          {
            "path": "fixtures/kb-data/documents/field-guide.md",
            "expected": "fixtures/imports/field-guide.md",
            "kind": "text"
          }
        ]
      }
    },
    {
      "name": "import-crlf-document",
      "args": [
        "import",
        "--data-dir",
        "fixtures/kb-data",
        "fixtures/imports/windows-notes.md"
      ],
      "stdin": null,
      "expect": {
        "exit_code": 0,
        "stdout": "expected/import-crlf.json",
        "kind": "json",
        "files": [
          {
            "path": "fixtures/kb-data/documents/windows-notes.md",
            "expected": "fixtures/imports/windows-notes.md",
            "kind": "text"
          }
        ]
