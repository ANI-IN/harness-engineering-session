# --- build-session working files (never shipped) ---
_reference/
RESEARCH.md
PROPOSAL.md
build_state.json
BUILD_PROGRESS.md
# The session handoff is local state by nature: it names unpushed commits,
# carries the working briefs, and is stale the moment a session ends. The
# shipped artifact is library/templates/session-handoff.md.
session-handoff.md

# --- dependencies ---
node_modules/
.venv/

# --- build / test caches and outputs ---
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage
*.tsbuildinfo
.vite/
.vitest/

# --- logs and OS/editor noise ---
*.log
.DS_Store
.idea/
.vscode/
*.swp
/projects/*/kb-data/

# --- never ignore the grading authority ---
# Fixtures and expected outputs are committed content: they grade both
# tracks. Broad rules above (kb-data/, *.log) have twice swallowed one,
# leaving the working tree green while a fresh clone failed. These
# negations are enforced by check_ignored_content in
# tools/lint/check_structure.py, which fails the build on any ignored file
# under a unit's fixtures/ or expected/.
!lectures/**/fixtures/**
!lectures/**/expected/**
!projects/**/fixtures/**
!projects/**/expected/**
