# --- build-session working files (never shipped) ---
_reference/
RESEARCH.md
PROPOSAL.md
build_state.json
BUILD_PROGRESS.md

# --- dependencies ---
node_modules/
.venv/

# --- build / test caches and outputs ---
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage
*.tsbuildinfo
.vite/
.vitest/

# --- logs and OS/editor noise ---
*.log
.DS_Store
.idea/
.vscode/
*.swp
# `kb-data` is learner scratch a project's own commands create. The glob
# covers the collided-copy form (`kb-data 2`) too: a fence copying into a
# directory that already exists produces one, and it must not read as
# curriculum content.
/projects/*/kb-data*/

# --- never ignore the grading authority ---
# Fixtures and expected outputs are committed content: they grade both
# tracks. Broad rules above (kb-data/, *.log) have twice swallowed one,
# leaving the working tree green while a fresh clone failed. These
# negations are enforced by check_ignored_content in
# tools/lint/check_structure.py, which fails the build on any ignored file
# under a unit's fixtures/ or expected/.
!lectures/**/fixtures/**
!lectures/**/expected/**
!projects/**/fixtures/**
!projects/**/expected/**
